# Provider Selection: 'gemini', 'ollama', or 'vllm'
LLM_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Model Sampling & Hyperparameter Configuration
AGENT_TEMPERATURE=0.1
LLM_TEMPERATURE=0.2

# Agent Controller & Guardrail Configuration
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT_SECONDS=30.0
USE_AGENT=true
PROMPT_VERSION=w16_react_v1

# RAG & ChromaDB Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
RAG_TOP_K=3
CHROMA_PATH=data/chroma
COLLECTION_NAME=documents

# Context Engineering & Scratchpad Budgets
MAX_CHUNK_CHARS=400
MAX_OBSERVATION_CHARS=1200
MAX_DETAILED_STEPS=2

# Ollama Local Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120.0

# vLLM Local Configuration
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct
VLLM_TIMEOUT=120.0

# Frontend Web UI Configuration
BACKEND_URL=http://localhost:8000

# API Rate Limiting Configuration
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Fallback & Retry Configuration
FALLBACK_ENABLED=true
FALLBACK_PROVIDER=ollama
MAX_RETRIES=2
RETRY_BASE_DELAY=0.5

# Response Caching Configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=100
